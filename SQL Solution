CREATE TABLE REGISTRATIONS(
REGISTRATION_ID INT AUTO_INCREMENT PRIMARY KEY,
USER_ID INT,
FOREIGN KEY(USER_ID) REFERENCES USERS(USER_ID),
EVENT_ID INT,
FOREIGN KEY (EVENT_ID) REFERENCES EVENTS(EVENT_ID),
REGISTRATION_DATE DATE NOT NULL
);
