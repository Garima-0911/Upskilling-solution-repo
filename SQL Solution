-- que 1
SELECT TITLE FROM EVENTS WHERE STATUS = "UPCOMING";

-- QUE2
SELECT 
EVENTS.EVENT_ID ,
EVENTS.TITLE, 
AVG(FEEDBACK.RATING) AS AVG_RATING
FROM EVENTS
JOIN FEEDBACK ON EVENTS.EVENT_ID = FEEDBACK.EVENT_ID
GROUP BY EVENTS.EVENT_ID,EVENTS.TITLE
HAVING COUNT(FEEDBACK.FEEDBACK_ID)>=10
ORDER BY AVG_RATING DESC;
















